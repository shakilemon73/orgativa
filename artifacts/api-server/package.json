{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/worker.ts --port 8787",
    "build:frontend": "pnpm -C ../.. --filter @workspace/orgativa run build",
    "build": "pnpm run build:frontend && wrangler deploy --dry-run --outdir dist",
    "deploy": "pnpm run build:frontend && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.11",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/node": "catalog:",
    "wrangler": "^4.118.0"
  }
}
